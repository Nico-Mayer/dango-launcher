amends "package://github.com/jdx/hk/releases/download/v2.0.0/hk@2.0.0#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v2.0.0/hk@2.0.0#/Builtins.pkl"

local cargoFmt = Builtins.cargo_fmt

local clippy = (Builtins.cargo_clippy) {
  check = new CommandSpec {
    command = "cargo clippy --manifest-path {{workspace_indicator}} --all-targets -- -D warnings"
    effect = "read"
  }
  fix = null
}

hooks {
  ["pre-commit"] {
    fix = true
    stash = "git"
    steps {
      ["cargo-fmt"] = cargoFmt
    }
  }
  ["pre-push"] {
    steps {
      ["clippy"] = clippy
    }
  }
  ["check"] {
    steps {
      ["cargo-fmt"] = cargoFmt
      ["clippy"] = clippy
    }
  }
  ["fix"] {
    fix = true
    steps {
      ["cargo-fmt"] = cargoFmt
    }
  }
}
