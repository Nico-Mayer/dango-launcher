// Example Dango configuration.
//
// This file documents every setting with comments. The live config.json cannot
// have comments, because JSON has none and a future settings UI writing the file
// could not keep them. Copy the parts you want into ~/.config/dango/config.json
// (or the directory named by $DANGO_CONFIG_DIR) as plain JSON.
//
// Everything here is optional. Anything you leave out uses its built-in default,
// so an empty file, or no file at all, is a valid configuration.
{
  // The config schema version. Leave it at 1.
  "version": 1,

  "launcher": {
    // The chord that summons the launcher. Portable tokens work on both
    // machines: "mod" is Cmd on macOS and Ctrl on Windows. The default is
    // Option+Space on macOS and Alt+Space on Windows.
    "hotkey": "alt+space"

    // A chord can also differ per platform:
    // "hotkey": { "macos": "cmd+space", "windows": "ctrl+space" }
  },

  "extensions": {
    "dango.clipboard": {
      // Turn an extension off. Absent means on.
      "enabled": true,
      // Override an extension's preferences, by the extension's own keys.
      "preferences": {
        "entries": 200,
        "excluded-applications": "Proton Pass, 1Password",
        // What Enter does to a history entry: "paste" puts it into the app you
        // were in and leaves it on the clipboard; "copy" only puts it on the
        // clipboard. The other one stays in the action panel. Default "paste".
        "primary-action": "copy"
      }
    },

    "dango.applications": {
      // Open an application, or bring it to the front, from a global hotkey. The
      // key is the name Dango shows for the app in root search, matched ignoring
      // case. A chord bound here and to a command is reported, first wins.
      "apps": {
        "Safari": { "hotkey": "hyper+b" },
        // When the name differs per platform, name it for each. A missing side
        // means the entry does nothing on that platform. The name is the one
        // root search shows, so it follows the system language.
        "editor": {
          "name": { "macos": "TextEdit", "windows": "Notepad" },
          "hotkey": "hyper+e"
        }
      }
    },

    "dango.ai": {
      // Where the AI commands go for an answer. The key of each entry is the
      // name commands refer to it by, and the name its API key is filed under
      // in auth.json (which lives beside this file and must stay out of git).
      "providers": {
        // "kind": "anthropic" speaks Anthropic's own protocol.
        "anthropic": { "kind": "anthropic", "model": "claude-sonnet-5" },
        // "kind": "ollama" is a model on this machine. No key, nothing leaves
        // the machine. The baseUrl defaults to http://localhost:11434.
        "local": { "kind": "ollama", "model": "qwen3:8b" },
        // "kind": "openai" is any OpenAI-compatible endpoint: OpenRouter, LM
        // Studio, vLLM, and most others. It needs a baseUrl.
        "openrouter": {
          "kind": "openai",
          "baseUrl": "https://openrouter.ai/api/v1",
          "model": "z-ai/glm-4.6"
        },
        // "kind": "cli" runs a program that takes a prompt and prints an answer.
        // It needs no key: the program is already signed in, which is how a
        // ChatGPT or Claude subscription pays for a transform instead of API
        // credits. {prompt} and {model} are replaced in the arguments; with no
        // {prompt}, the prompt goes in on standard input. Expect seconds of
        // startup, so keep these for the commands you do not run from a hotkey.
        "claude": { "kind": "cli", "command": "claude", "args": ["-p"] },
        "codex": { "kind": "cli", "command": "codex", "args": ["exec", "-"] },
        "pi": { "kind": "cli", "command": "pi", "args": ["--print", "{prompt}"] }
      },

      "preferences": {
        // The provider a command uses when it names none. With exactly one
        // provider configured, that one is the default and this can be omitted.
        "provider": "local",
        // How hard the model thinks when a command does not say: off, low,
        // medium, or high. Models that cannot think ignore it. Default off.
        "thinking": "off"
      },

      "commands": {
        // Dango ships Improve Writing, Fix Spelling and Grammar, Make Shorter,
        // Make Longer, Make Simpler, Make Professional, Summarize, Explain This,
        // and Translate. Each one acts on the text you have selected.
        //
        // Give a shipped command its own model, a hotkey, and what to do with
        // the answer: "view" shows it (the default), "paste" puts it back where
        // you were, replacing the selection, and "copy" puts it on the clipboard.
        "improve-writing": {
          "provider": "anthropic",
          "thinking": "low",
          "output": "paste",
          "hotkey": "hyper+i"
        },

        // Turn off one you do not want.
        "make-longer": { "enabled": false },

        // Add your own: a title and a prompt make a command of it. A name in
        // double braces that is not "selection" or "clipboard" is asked for
        // before the command runs.
        "review-rust": {
          "title": "Review Rust",
          "prompt": "Review this Rust for correctness and idiom. Answer with the issues only, as plain prose.\n\n{{ selection }}",
          "model": "claude-opus-5",
          "alias": "rr"
        }
      }
    },

    "dango.window-management": {
      "commands": {
        "left-half": {
          // A short alias to match this command in root search.
          "alias": "lh",
          // A global hotkey for this command, in the launcher's grammar. Pressing
          // it runs the command from anywhere: a no-view command (like this one)
          // runs without showing the launcher and acts on the focused window; a
          // view command shows the launcher with its view. If two commands claim
          // one chord, or a command claims the launcher chord, the first wins and
          // the rest are reported in the tray status and dango.log.
          "hotkey": "hyper+left"
        }
      }
    }
  },

  // A physical key remapped to act as the hyper modifier system-wide, the way
  // Raycast and Hyperkey do. While it is held, Ctrl+Alt+Shift+Super are in
  // effect, so a chord like "hyper+left" fires from this one key. Omit the block
  // to turn it off.
  "hyperkey": {
    // The physical key to remap. Defaults to capslock.
    "key": "capslock",
    // Whether Shift is part of the combination. Default true. Set false to emit
    // Ctrl+Alt+Super, which leaves typed characters unshifted.
    "shift": true,
    // A key to send on a quick, solitary tap of the hyperkey. A hold, or a press
    // combined with another key, still acts as the hyper modifier. Omit for no
    // tap action. A common setup is Escape on tap, hyper on hold.
    "tap": "escape"
  }
}
