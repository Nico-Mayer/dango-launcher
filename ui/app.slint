import { Palette as StdPalette } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { IconKind } from "atoms/icon.slint";
import { AccessoryData, AccessoryKind } from "atoms/accessory.slint";
import { TagRole } from "atoms/tag.slint";
import { ToastStyle } from "atoms/dot.slint";
import { AtomGallery } from "atoms/gallery.slint";
import { OptionData } from "atoms/dropdown.slint";
import {
    ActionData, DetailData, EmptyData, FieldData, FieldKind, FormData, Intents, ListData,
    MetaData, Panel, RowData, ScreenKind, Search, Shell,
} from "globals.slint";
import { LauncherWindow } from "shell/launcher-window.slint";

export {
    AccessoryData, AccessoryKind, ActionData, AtomGallery, DetailData, EmptyData, FieldData,
    FieldKind, FormData, IconKind, Intents, LauncherWindow, ListData, MetaData, OptionData, Panel,
    RowData,
    ScreenKind, Search, Shell, StdPalette, TagRole, Theme, ToastStyle,
}

export component Tray inherits SystemTrayIcon {
    in property <image> image;
    in property <string> hint;
    in property <[string]> lines;
    in property <bool> grant-accessibility;
    in property <bool> grant-input-monitoring;
    callback toggle();
    callback quit();
    callback grant(permission: int);
    icon: root.image;
    tooltip: root.hint;

    Menu {
        if root.grant-accessibility: MenuItem {
            title: "Grant Accessibility";
            activated => {
                root.grant(0);
            }
        }
        if root.grant-input-monitoring: MenuItem {
            title: "Grant Input Monitoring";
            activated => {
                root.grant(1);
            }
        }
        for line in root.lines: MenuItem {
            title: line;
            enabled: false;
        }
        MenuItem {
            title: "Show or hide Dango";
            activated => {
                root.toggle();
            }
        }
        MenuItem {
            title: "Quit Dango";
            activated => {
                root.quit();
            }
        }
    }
}
