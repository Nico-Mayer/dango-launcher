import { Palette } from "std-widgets.slint";

// Variable fonts: one file per face carries every weight.
import "fonts/Geist-Variable.ttf";
import "fonts/GeistMono-Variable.ttf";

/// Every colour, radius, size, and type face on every surface. The scheme
/// follows the operating system through the std-widgets palette, which reads
/// it when nothing sets it.
export global Theme {
    out property <bool> dark: Palette.color-scheme == ColorScheme.dark;

    out property <color> background: root.dark ? #161618 : #fbfbfa;
    out property <color> surface: root.dark ? #1e1e21 : #ffffff;
    out property <color> raised: root.dark ? #26262a : #f1f1ef;
    out property <color> border: root.dark ? #2f2f34 : #e4e4e1;
    out property <color> text: root.dark ? #ededef : #18181b;
    out property <color> muted: root.dark ? #9a9aa2 : #6b6b72;
    out property <color> accent: root.dark ? #ff6363 : #c0282d;
    out property <color> selection: root.dark ? #ffffff12 : #0000000e;
    out property <color> hover: root.dark ? #ffffff08 : #00000006;
    out property <color> danger: root.dark ? #ff8080 : #b71c1c;
    out property <color> shadow: root.dark ? #00000080 : #00000030;

    out property <length> radius: 8px;
    out property <length> gap: 8px;
    out property <length> row-height: 40px;
    out property <length> heading-height: 28px;
    out property <length> search-height: 56px;
    out property <length> action-bar-height: 40px;
    out property <length> icon-size: 20px;
    out property <length> window-width: 720px;
    out property <length> panel-width: 280px;
    out property <length> panel-row-height: 32px;
    out property <length> list-padding: 6px;
    out property <length> panel-padding: 6px;
    out property <length> panel-filter-height: 36px;
    out property <length> panel-margin: 8px;
    out property <length> detail-image-height: 200px;
    out property <length> hud-width: 560px;
    out property <length> hud-height: 36px;
    out property <length> hud-padding: 14px;
    out property <float> loading-sweep-width: 0.25;
    out property <duration> loading-sweep-period: 1.2s;

    out property <length> text-small: 12px;
    out property <length> text-body: 14px;
    out property <length> text-large: 16px;

    out property <string> font: "Geist";
    out property <string> mono: "Geist Mono";
}
