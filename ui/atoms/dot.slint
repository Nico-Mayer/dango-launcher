import { Theme } from "../theme.slint";

export enum Status { working, needs-input, done, failed, queued }

/// Still in every state. Only an accessory dot announces its state; a ticker's
/// text already says it.
export component Dot inherits Rectangle {
    in property <Status> status;
    in property <bool> announce;
    width: 6px;
    height: 6px;
    border-radius: 3px;
    accessible-role: image;
    accessible-label: !root.announce ? ""
        : root.status == Status.working ? "Working"
        : root.status == Status.needs-input ? "Needs input"
        : root.status == Status.done ? "Done"
        : root.status == Status.failed ? "Failed" : "Queued";
    background: root.status == Status.working ? Theme.working
        : root.status == Status.needs-input ? Theme.blocked
        : root.status == Status.done ? Theme.done
        : root.status == Status.failed ? Theme.danger : Theme.idle;
}
