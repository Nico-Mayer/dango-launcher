import { Icon, IconKind } from "icon.slint";
import { Kbd } from "kbd.slint";
import { Tag, TagRole } from "tag.slint";
import { Accessory, AccessoryKind } from "accessory.slint";
import { Dot, ToastStyle } from "dot.slint";
import { Progress, ProgressKind } from "progress.slint";

/// Every atom on its own, for the UI tests.
export component AtomGallery inherits Window {
    in property <string> chord;
    VerticalLayout {
        alignment: start;
        Icon {
            label: "Icon";
        }
        Kbd {
            keys: root.chord;
        }
        Tag {
            text: "Link";
            role: TagRole.accent;
        }
        Accessory {
            data: { kind: AccessoryKind.text, text: "2m" };
        }
        Dot {
            style: ToastStyle.busy;
            label: "Busy";
        }
        Progress {
            kind: ProgressKind.ring;
            value: 0.42;
            width: 16px;
            height: 16px;
            accessible-description: "Part done";
        }
        Progress {
            kind: ProgressKind.ring;
            value: 1;
            width: 16px;
            height: 16px;
            accessible-description: "All done";
        }
        Progress {
            kind: ProgressKind.ring;
            width: 16px;
            height: 16px;
        }
        Progress {
            kind: ProgressKind.bar;
            value: 0.62;
            height: 4px;
            accessible-description: "Bar";
        }
    }
}
