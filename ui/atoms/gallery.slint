import { Icon, IconKind } from "icon.slint";
import { Kbd } from "kbd.slint";
import { Tag, TagRole } from "tag.slint";
import { Accessory, AccessoryKind } from "accessory.slint";
import { Dot, Status } from "dot.slint";
import { Progress, ProgressKind } from "progress.slint";
import { Skeleton } from "skeleton.slint";

/// Every atom on its own, for the UI tests.
export component AtomGallery inherits Window {
    in property <string> chord;
    VerticalLayout {
        alignment: start;
        Icon {
            label: "Icon";
        }
        HorizontalLayout {
            alignment: start;
            Kbd {
                keys: root.chord;
            }
        }
        Tag {
            text: "Link";
            role: TagRole.accent;
        }
        Accessory {
            data: { kind: AccessoryKind.text, text: "2m" };
        }
        Dot {
            status: Status.working;
            announce: true;
        }
        Dot {
            status: Status.needs-input;
            announce: true;
        }
        Dot {
            status: Status.done;
            announce: true;
        }
        Dot {
            status: Status.failed;
            announce: true;
        }
        Dot {
            status: Status.queued;
            announce: true;
        }
        Dot {
            status: Status.done;
        }
        Progress {
            kind: ProgressKind.ring;
            value: 0.42;
            width: 16px;
            height: 16px;
            accessible-description: "Part done";
        }
        Progress {
            kind: ProgressKind.ring;
            value: 1;
            width: 16px;
            height: 16px;
            accessible-description: "All done";
        }
        Progress {
            kind: ProgressKind.ring;
            width: 16px;
            height: 16px;
        }
        Progress {
            kind: ProgressKind.bar;
            value: 0.62;
            height: 4px;
            accessible-description: "Bar";
        }
        Skeleton {
            height: 3 * 44px;
        }
    }
}
