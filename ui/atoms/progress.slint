import { Theme } from "../theme.slint";

export enum ProgressKind { bar, ring }

/// A value below 0 is indeterminate: the mark moves without claiming an
/// amount. A small indeterminate ring is the spinner. The caller sets the
/// size.
export component Progress inherits Rectangle {
    in property <ProgressKind> kind;
    in property <float> value: -1;
    in property <color> track: Theme.raised;
    in property <color> fill: Theme.working;
    in property <duration> period: 1.2s;
    property <bool> indeterminate: root.value < 0;
    property <float> turn: mod(animation-tick(), root.period) / root.period;

    accessible-role: progress-indicator;
    accessible-label: root.indeterminate ? "Working" : "";
    accessible-value: root.indeterminate ? "" : "\{round(min(1, root.value) * 100)}";
    accessible-value-minimum: 0;
    accessible-value-maximum: 100;

    if root.kind == ProgressKind.bar: Rectangle {
        background: root.track;
        clip: true;
        if !root.indeterminate: Rectangle {
            x: 0;
            width: parent.width * clamp(root.value, 0, 1);
            background: root.fill;
        }
        if root.indeterminate: Rectangle {
            width: parent.width * Theme.loading-sweep-width;
            x: -self.width + (parent.width + self.width) * root.turn;
            background: root.fill;
        }
    }

    if root.kind == ProgressKind.ring: Rectangle {
        Path {
            width: 100%;
            height: 100%;
            viewbox-width: 100;
            viewbox-height: 100;
            stroke: root.track;
            stroke-width: 2px;
            MoveTo {
                x: 50;
                y: 8;
            }
            ArcTo {
                radius-x: 42;
                radius-y: 42;
                x: 50;
                y: 92;
                sweep: true;
            }
            ArcTo {
                radius-x: 42;
                radius-y: 42;
                x: 50;
                y: 8;
                sweep: true;
            }
        }
        // Slint's own spinner workaround: an arc that ends where it starts
        // draws nothing, and femtovg needs the short line to fill a circle.
        arc := Path {
            property <float> start: root.indeterminate ? root.turn : 0;
            property <float> share: root.indeterminate ? 0.25 : min(0.9999, clamp(root.value, 0, 1));
            width: 100%;
            height: 100%;
            viewbox-width: 100;
            viewbox-height: 100;
            stroke: root.fill;
            stroke-width: 2px;
            MoveTo {
                x: 50 - 42 * sin(-(arc.start - 0.001) * 360deg);
                y: 50 - 42 * cos(-(arc.start - 0.001) * 360deg);
            }
            LineTo {
                x: 50 - 42 * sin(-arc.start * 360deg);
                y: 50 - 42 * cos(-arc.start * 360deg);
            }
            ArcTo {
                radius-x: 42;
                radius-y: 42;
                x: 50 - 42 * sin(-(arc.start + arc.share) * 360deg);
                y: 50 - 42 * cos(-(arc.start + arc.share) * 360deg);
                sweep: arc.share > 0;
                large-arc: arc.share > 0.5;
            }
        }
    }
}
