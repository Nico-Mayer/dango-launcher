import { Theme } from "../theme.slint";
import { Progress, ProgressKind } from "../atoms/progress.slint";
import { Icon, IconKind } from "../atoms/icon.slint";
import { Intents, Search, Shell } from "../globals.slint";

/// The query for a list, or the command's title for a detail or form.
export component SearchBar inherits Rectangle {
    height: Theme.search-height;

    public function set-text(text: string) {
        input.text = text;
        // Slint keeps the old cursor offset, so a query restored after an
        // empty view would get the cursor at its start.
        input.select-all();
        input.clear-selection();
    }

    public function take-focus(select: bool) {
        input.focus();
        if select {
            input.select-all();
        }
    }

    HorizontalLayout {
        padding-left: Shell.can-go-back ? 12px : 18px;
        padding-right: 12px;
        spacing: 12px;

        if Shell.can-go-back: VerticalLayout {
            alignment: center;
            Rectangle {
                width: Theme.icon-size + 8px;
                height: Theme.icon-size + 8px;
                border-radius: self.height / 2;
                background: back-touch.has-hover ? Theme.selected : Theme.hover;
                accessible-role: button;
                accessible-label: "Go back";
                accessible-action-default => {
                    Intents.go-back();
                }
                Icon {
                    source: Shell.back-icon;
                    kind: IconKind.named;
                    role: Theme.muted;
                }
                back-touch := TouchArea {
                    clicked => {
                        Intents.go-back();
                    }
                }
            }
        }

        // The query and the title share one slot: a hidden element keeps its
        // place in a layout, so separate slots would split the width.
        Rectangle {
            horizontal-stretch: 1;

            Rectangle {
                width: parent.width;
                height: parent.height;
                visible: Shell.typing;
                accessible-role: text-input;
                accessible-label: Search.placeholder;
                accessible-placeholder-text: Search.placeholder;
                accessible-value: input.text;
                accessible-action-set-value(value) => {
                    input.text = value;
                    Intents.query-edited(value);
                }
                Text {
                    x: 0;
                    width: parent.width;
                    text: input.text == "" && input.preedit-text == "" ? Search.placeholder : "";
                    color: Theme.dim;
                    font-size: Theme.text-large;
                    vertical-alignment: center;
                    overflow: elide;
                    accessible-role: none;
                }
                input := TextInput {
                    x: 0;
                    width: parent.width;
                    height: parent.height;
                    single-line: true;
                    color: Theme.foreground;
                    selection-background-color: Theme.selection;
                    selection-foreground-color: Theme.foreground;
                    font-size: Theme.text-large;
                    vertical-alignment: center;
                    accessible-role: none;
                    edited => {
                        Intents.query-edited(self.text);
                    }
                }
            }

            if !Shell.typing: Text {
                x: 0;
                width: parent.width;
                height: parent.height;
                text: Shell.title;
                color: Theme.foreground;
                font-size: Theme.text-large;
                font-weight: 500;
                vertical-alignment: center;
                overflow: elide;
                accessible-role: AccessibleRole.text;
                accessible-label: Shell.title;
            }
        }

        if Shell.typing && Search.filter-shown: VerticalLayout {
            alignment: center;
            horizontal-stretch: 0;
            Rectangle {
                height: 28px;
                border-radius: self.height / 2;
                background: filter-touch.has-hover ? Theme.selected : Theme.hover;
                accessible-role: combobox;
                accessible-label: "Filter results";
                accessible-value: Search.filter-options[Search.filter-current].title;
                accessible-action-default => {
                    filter-popup.show();
                }
                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    spacing: 6px;
                    Text {
                        text: Search.filter-options[Search.filter-current].title;
                        color: Theme.muted;
                        font-size: Theme.text-small;
                        vertical-alignment: center;
                        accessible-role: none;
                    }
                    Text {
                        text: "▾";
                        color: Theme.muted;
                        font-size: Theme.text-small;
                        vertical-alignment: center;
                        accessible-role: none;
                    }
                }
                filter-touch := TouchArea {
                    clicked => {
                        filter-popup.show();
                    }
                }
                filter-popup := PopupWindow {
                    x: parent.width - self.width;
                    y: parent.height + 4px;
                    width: 200px;
                    Rectangle {
                        background: Theme.popover;
                        border-radius: Theme.radius;
                        border-width: 1px;
                        border-color: Theme.border;
                        drop-shadow-blur: 16px;
                        drop-shadow-offset-y: 4px;
                        drop-shadow-color: Theme.shadow;
                        VerticalLayout {
                            padding: 4px;
                            for option[index] in Search.filter-options: Rectangle {
                                height: Theme.panel-row-height;
                                border-radius: Theme.radius / 2;
                                background: index == Search.filter-current ? Theme.selected
                                    : option-touch.has-hover ? Theme.hover : transparent;
                                accessible-role: list-item;
                                accessible-label: option.title;
                                accessible-item-selected: index == Search.filter-current;
                                accessible-action-default => {
                                    Intents.filter-chosen(option.id);
                                }
                                Text {
                                    x: 10px;
                                    text: option.title;
                                    color: Theme.foreground;
                                    font-size: Theme.text-body;
                                    vertical-alignment: center;
                                    accessible-role: none;
                                }
                                option-touch := TouchArea {
                                    clicked => {
                                        Intents.filter-chosen(option.id);
                                        filter-popup.close();
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    // Kept clear of the rounded ends: the software renderer clips to a square,
    // not to the pill.
    if Shell.loading: Progress {
        kind: ProgressKind.bar;
        x: parent.height / 2;
        width: parent.width - parent.height;
        y: parent.height - 2px;
        height: 2px;
        track: Theme.border;
        fill: Theme.accent;
        accessible-label: "Loading…";
    }
}
