import { Theme } from "../theme.slint";
import { AnswerData, Intents, Panel, ScreenKind, Shell } from "../globals.slint";
import { SearchBar } from "search-bar.slint";
import { ActionBar } from "action-bar.slint";
import { ActionPanel } from "action-panel.slint";
import { List } from "../views/list.slint";
import { Grid } from "../views/grid.slint";
import { Detail } from "../views/detail.slint";
import { EmptyView } from "../views/empty-view.slint";
import { Form } from "../views/form.slint";
import { InlineAnswer } from "inline-answer.slint";
import { ProgressView } from "../views/progress-view.slint";

/// The SearchBar, one view, and the ActionBar, with the action panel
/// floating above them.
export component LauncherWindow inherits Window {
    no-frame: true;
    always-on-top: true;
    background: transparent;
    title: "Dango";
    width: Theme.window-width;
    height: Shell.height;
    default-font-size: Theme.text-body;
    default-font-family: Theme.font;
    out property <bool> toast-cut: Shell.toast-shown && action-bar.toast-cut;

    public function set-query(text: string) {
        search.set-text(text);
    }

    public function focus-prompt(select: bool) {
        search.take-focus(select);
    }

    public function focus-surface() {
        surface.focus();
    }

    public function reveal-row(top: length, height: length) {
        list.reveal(top, height);
    }

    public function reveal-tile(top: length, height: length) {
        grid.reveal(top, height);
    }

    public function reveal-action(top: length, height: length) {
        panel.reveal(top, height);
    }

    public function set-panel-filter(text: string) {
        panel.set-filter(text);
    }

    public function focus-panel-filter() {
        panel.focus-filter();
    }

    surface := FocusScope {
        capture-key-pressed(event) => {
            Shell.pointer-resting = true;
            if Intents.key(event.text, event.modifiers.control, event.modifiers.alt, event.modifiers.shift, event.modifiers.meta) {
                return accept;
            }
            reject
        }

        // Plain rectangles let a click through, so the pill and the card each
        // hold an empty TouchArea that keeps their clicks from reaching this one.
        TouchArea {
            clicked => {
                Intents.clicked-outside();
            }
        }

        pill := Rectangle {
            y: 0;
            height: Theme.search-height;
            background: Theme.popover;
            border-radius: self.height / 2;
            accessible-role: groupbox;
            accessible-label: "Search bar";

            TouchArea { }

            search := SearchBar { }

            // Drawn last so the SearchBar's fill does not paint over it.
            Rectangle {
                border-radius: parent.border-radius;
                border-width: 1px;
                border-color: Theme.border;
            }
        }

        card := Rectangle {
            visible: Shell.card-shown;
            y: Theme.search-height + Theme.shell-gap;
            height: max(0, Shell.launcher-height - self.y);
            background: Theme.popover;
            border-radius: Theme.card-radius;
            accessible-role: groupbox;
            accessible-label: "Results";
            clip: true;

            TouchArea { }

            property <length> body-height: self.height - Theme.action-bar-height;
            property <length> answer-room: AnswerData.shown ? Theme.answer-height : 0;

            if AnswerData.shown: InlineAnswer {
                y: 0;
            }

            list := List {
                visible: Shell.screen == ScreenKind.root || Shell.screen == ScreenKind.list;
                y: parent.answer-room;
                height: parent.body-height - parent.answer-room;
            }
            grid := Grid {
                visible: Shell.screen == ScreenKind.grid;
                y: 0;
                height: parent.body-height;
            }
            if Shell.screen == ScreenKind.empty: EmptyView {
                y: 0;
                height: parent.body-height;
            }
            if Shell.screen == ScreenKind.detail: Detail {
                y: 0;
                height: parent.body-height;
            }
            if Shell.screen == ScreenKind.form: Form {
                y: 0;
                height: parent.body-height;
            }
            if Shell.screen == ScreenKind.progress: ProgressView {
                y: 0;
                height: parent.body-height;
            }

            // Rounded itself: the software renderer, which Windows falls back
            // to without OpenGL 2, clips children to a square, not to the
            // card's corners.
            action-bar := ActionBar {
                y: parent.height - Theme.action-bar-height;
                border-bottom-left-radius: card.border-radius;
                border-bottom-right-radius: card.border-radius;
            }

            // Swallows a press outside the open panel, so it never reaches the
            // view underneath. The state machine decides what it means.
            if Panel.open: TouchArea {
                clicked => {
                    Intents.close-panel();
                }
            }

            panel := ActionPanel {
                visible: Panel.open;
                width: min(Theme.panel-width, parent.width - 2 * Theme.panel-margin);
                height: min(self.content-height, parent.height - Theme.action-bar-height - 2 * Theme.panel-margin);
                x: parent.width - self.width - Theme.panel-margin;
                y: parent.height - Theme.action-bar-height - self.height - Theme.panel-margin;
            }

            // Drawn last so no region paints over the outline.
            Rectangle {
                border-radius: card.border-radius;
                border-width: 1px;
                border-color: Theme.border;
            }
        }
    }
}
