import { Theme } from "../theme.slint";
import { Dot, Status } from "../atoms/dot.slint";
import { TickerStyle } from "../globals.slint";

/// A ticker on its own, for while the launcher is hidden. The window keeps one
/// size so the shell can place it before Slint lays it out; the pill inside
/// fits its text.
export component NoticeWindow inherits Window {
    in property <TickerStyle> style;
    in property <string> text;
    /// The text does not fit and is cut off.
    out property <bool> cut: label.preferred-width > label.width;
    no-frame: true;
    always-on-top: true;
    background: transparent;
    title: "Dango";
    width: Theme.notice-width;
    height: Theme.notice-height;
    default-font-size: Theme.text-body;
    default-font-family: Theme.font;

    pill := Rectangle {
        width: min(parent.width, label.preferred-width + 2 * Theme.notice-padding + dot.width + Theme.gap);
        height: parent.height;
        background: Theme.popover;
        border-radius: self.height / 2;
        border-width: 1px;
        border-color: Theme.border;

        HorizontalLayout {
            padding-left: Theme.notice-padding;
            padding-right: Theme.notice-padding;
            spacing: Theme.gap;

            VerticalLayout {
                alignment: center;
                dot := Dot {
                    status: root.style == TickerStyle.failure ? Status.failed : Status.done;
                }
            }

            label := Text {
                text: root.text;
                color: root.style == TickerStyle.failure ? Theme.foreground : Theme.muted;
                font-size: Theme.text-small;
                vertical-alignment: center;
                overflow: elide;
                accessible-role: AccessibleRole.text;
                accessible-label: self.text;
                accessible-description: root.style == TickerStyle.failure ? "Failed" : "";
            }
        }
    }
}
