import { Theme } from "../theme.slint";
import { Kbd } from "../atoms/kbd.slint";
import { Dot, Status } from "../atoms/dot.slint";
import { Progress, ProgressKind } from "../atoms/progress.slint";
import { Shell, ToastStyle } from "../globals.slint";

/// The toast's mark, text, and action, wherever it sits.
export component Toast inherits HorizontalLayout {
    /// The text does not fit and is cut off.
    out property <bool> cut: text.preferred-width > text.width;
    spacing: Theme.gap;

    VerticalLayout {
        alignment: center;
        if Shell.toast-style == ToastStyle.busy: Progress {
            kind: ProgressKind.ring;
            width: 12px;
            height: 12px;
        }
        if Shell.toast-style != ToastStyle.busy: Dot {
            status: Shell.toast-style == ToastStyle.failure ? Status.failed : Status.done;
        }
    }
    text := Text {
        text: Shell.toast-text;
        color: Shell.toast-style == ToastStyle.failure ? Theme.foreground : Theme.muted;
        horizontal-stretch: 1;
        font-size: Theme.text-small;
        vertical-alignment: center;
        overflow: elide;
        accessible-role: AccessibleRole.text;
        accessible-label: self.text;
        accessible-description: (Shell.toast-style == ToastStyle.failure ? "Failed" : "")
            + (Shell.toast-style == ToastStyle.failure && Shell.toast-action-label != "" ? ". " : "")
            + (Shell.toast-action-label != "" ? Shell.toast-action-label + ", " + Shell.toast-action-keys : "");
    }
    if Shell.toast-action-label != "": Text {
        text: Shell.toast-action-label;
        color: Theme.foreground;
        font-size: Theme.text-small;
        vertical-alignment: center;
        accessible-role: none;
    }
    if Shell.toast-action-label != "": VerticalLayout {
        alignment: center;
        Kbd {
            keys: Shell.toast-action-keys;
            accessible-role: none;
        }
    }
}
