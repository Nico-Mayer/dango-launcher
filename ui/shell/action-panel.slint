import { ScrollView } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { Kbd } from "../atoms/kbd.slint";
import { ActionData, Intents, Panel, Shell } from "../globals.slint";

component PanelHeading inherits Rectangle {
    in property <string> text;
    height: Theme.heading-height;
    HorizontalLayout {
        padding-left: 10px;
        Text {
            text: root.text;
            color: Theme.muted;
            font-size: Theme.text-small;
            font-weight: 500;
            vertical-alignment: center;
            accessible-role: AccessibleRole.text;
            accessible-label: root.text;
        }
    }
}

component PanelRow inherits Rectangle {
    in property <ActionData> data;
    height: Theme.panel-row-height;
    border-radius: Theme.radius / 2;
    background: root.data.selected ? Theme.selection
        : touch.has-hover && !Shell.pointer-resting ? Theme.hover : transparent;
    accessible-role: list-item;
    accessible-label: root.data.title;
    accessible-item-selected: root.data.selected;
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: Theme.gap;
        Text {
            text: root.data.title;
            color: root.data.danger ? Theme.danger : Theme.text;
            font-size: Theme.text-body;
            overflow: elide;
            vertical-alignment: center;
            horizontal-stretch: 1;
            accessible-role: none;
        }
        if root.data.shortcut != "": VerticalLayout {
            alignment: center;
            horizontal-stretch: 0;
            Kbd {
                keys: root.data.shortcut;
            }
        }
    }
    touch := TouchArea {
        clicked => {
            Intents.activate(root.data.id);
        }
        changed mouse-x => {
            Shell.pointer-resting = false;
        }
        changed mouse-y => {
            Shell.pointer-resting = false;
        }
    }
}

/// Every action on the selection, floating above the ActionBar, with its own
/// filter at the bottom.
export component ActionPanel inherits Rectangle {
    property <length> filter-height: 36px;
    out property <length> content-height: (Panel.rows.length > 0 ? column.preferred-height : Theme.panel-row-height + 12px) + self.filter-height;
    background: Theme.surface;
    border-radius: Theme.radius;
    border-width: 1px;
    border-color: Theme.border;
    drop-shadow-blur: 24px;
    drop-shadow-offset-y: 8px;
    drop-shadow-color: Theme.shadow;
    accessible-role: list;
    accessible-label: "Actions";

    public function reveal(top: length, height: length) {
        if top + scroller.content-y < 0 {
            scroller.content-y = -top;
        } else if top + height + scroller.content-y > scroller.visible-height {
            scroller.content-y = scroller.visible-height - top - height;
        }
    }

    public function set-filter(text: string) {
        filter.text = text;
    }

    public function focus-filter() {
        filter.focus();
    }

    scroller := ScrollView {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height - root.filter-height;

        column := VerticalLayout {
            padding: 6px;
            for row in Panel.rows: Rectangle {
                height: row.heading != "" ? Theme.heading-height : Theme.panel-row-height;
                if row.heading != "": PanelHeading {
                    text: row.heading;
                }
                if row.heading == "": PanelRow {
                    data: row;
                }
            }
        }
    }

    if Panel.rows.length == 0: Text {
        x: 16px;
        y: 6px;
        height: Theme.panel-row-height;
        text: "No matching actions";
        color: Theme.muted;
        font-size: Theme.text-body;
        vertical-alignment: center;
        accessible-role: AccessibleRole.text;
        accessible-label: self.text;
    }

    Rectangle {
        y: parent.height - root.filter-height;
        height: 1px;
        background: Theme.border;
    }

    Rectangle {
        x: 16px;
        y: parent.height - root.filter-height + 1px;
        width: parent.width - 32px;
        height: root.filter-height - 1px;
        accessible-role: text-input;
        accessible-label: "Search actions";
        accessible-placeholder-text: "Search actions";
        accessible-value: filter.text;
        accessible-action-set-value(value) => {
            filter.text = value;
            Intents.panel-filter-edited(value);
        }
        Text {
            x: 0;
            width: parent.width;
            text: filter.text == "" && filter.preedit-text == "" ? "Search actions" : "";
            color: Theme.muted;
            font-size: Theme.text-small;
            vertical-alignment: center;
            accessible-role: none;
        }
        filter := TextInput {
            x: 0;
            width: parent.width;
            height: parent.height;
            single-line: true;
            color: Theme.text;
            selection-background-color: Theme.selection;
            selection-foreground-color: Theme.text;
            font-size: Theme.text-small;
            vertical-alignment: center;
            accessible-role: none;
            edited => {
                Intents.panel-filter-edited(self.text);
            }
        }
    }
}
