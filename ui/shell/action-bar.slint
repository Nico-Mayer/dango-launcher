import { Theme } from "../theme.slint";
import { Icon, IconKind } from "../atoms/icon.slint";
import { Kbd } from "../atoms/kbd.slint";
import { Dot, Status } from "../atoms/dot.slint";
import { Intents, Shell, ToastStyle } from "../globals.slint";

/// Where the user is, or a toast, and what Enter does.
export component ActionBar inherits Rectangle {
    /// The context or toast does not fit and is cut off.
    out property <bool> label-cut: label.preferred-width > label.width;
    height: Theme.action-bar-height;
    background: Theme.chrome;

    Rectangle {
        y: 0;
        height: 1px;
        background: Theme.border;
    }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 12px;

        HorizontalLayout {
            horizontal-stretch: 1;
            spacing: Theme.gap;
            if Shell.toast-shown: VerticalLayout {
                alignment: center;
                Dot {
                    status: Shell.toast-style == ToastStyle.failure ? Status.failed
                        : Shell.toast-style == ToastStyle.success ? Status.done : Status.working;
                }
            }
            if !Shell.toast-shown && Shell.context-icon-kind != IconKind.none: VerticalLayout {
                alignment: center;
                Icon {
                    width: 16px;
                    height: 16px;
                    source: Shell.context-icon;
                    kind: Shell.context-icon-kind;
                }
            }
            label := Text {
                text: Shell.toast-shown ? Shell.toast-text : Shell.context;
                color: Shell.toast-shown && Shell.toast-style == ToastStyle.failure ? Theme.foreground : Theme.muted;
                font-size: Theme.text-small;
                vertical-alignment: center;
                overflow: elide;
                accessible-role: AccessibleRole.text;
                accessible-label: self.text;
                accessible-description: Shell.toast-shown && Shell.toast-style == ToastStyle.failure ? "Failed" : "";
            }
        }

        if Shell.primary-label != "": HorizontalLayout {
            horizontal-stretch: 0;
            spacing: Theme.gap;
            Text {
                text: Shell.primary-label;
                color: Theme.foreground;
                font-size: Theme.text-small;
                vertical-alignment: center;
                overflow: elide;
                max-width: 200px;
                accessible-role: AccessibleRole.text;
                accessible-label: Shell.primary-label;
            }
            VerticalLayout {
                alignment: center;
                Kbd {
                    keys: Shell.confirm-key;
                }
            }
        }

        if Shell.panel-hint: HorizontalLayout {
            horizontal-stretch: 0;
            spacing: 12px;
            VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 1px;
                    height: 14px;
                    background: Theme.border;
                }
            }
            Rectangle {
                accessible-role: button;
                accessible-label: "Actions";
                accessible-action-default => {
                    Intents.toggle-panel();
                }
                HorizontalLayout {
                    spacing: 6px;
                    Text {
                        text: "Actions";
                        color: actions-touch.has-hover ? Theme.foreground : Theme.muted;
                        font-size: Theme.text-small;
                        vertical-alignment: center;
                        accessible-role: none;
                    }
                    VerticalLayout {
                        alignment: center;
                        Kbd {
                            keys: Shell.panel-key;
                        }
                    }
                }
                actions-touch := TouchArea {
                    clicked => {
                        Intents.toggle-panel();
                    }
                }
            }
        }
    }
}
