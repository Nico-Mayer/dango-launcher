import { Theme } from "../theme.slint";
import { Icon, IconKind } from "../atoms/icon.slint";
import { Kbd } from "../atoms/kbd.slint";
import { Intents, Shell } from "../globals.slint";
import { Ticker } from "ticker.slint";

/// Where the user is, or a ticker, and what Enter does.
export component ActionBar inherits Rectangle {
    /// The ticker does not fit and is cut off.
    out property <bool> ticker-cut: ticker.cut;
    height: Theme.action-bar-height;
    background: Theme.chrome;

    Rectangle {
        y: 0;
        height: 1px;
        background: Theme.border;
    }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 12px;

        // Not a layout: a hidden element keeps its place in one, so the ticker
        // and the context would split the width.
        Rectangle {
            horizontal-stretch: 1;

            ticker := Ticker {
                visible: Shell.ticker-shown;
                width: parent.width;
                height: parent.height;
            }

            HorizontalLayout {
                visible: !Shell.ticker-shown;
                spacing: Theme.gap;
                if Shell.context-icon-kind != IconKind.none: VerticalLayout {
                    alignment: center;
                    Icon {
                        width: 16px;
                        height: 16px;
                        source: Shell.context-icon;
                        kind: Shell.context-icon-kind;
                    }
                }
                Text {
                    text: Shell.context;
                    color: Theme.muted;
                    horizontal-stretch: 1;
                    font-size: Theme.text-small;
                    vertical-alignment: center;
                    overflow: elide;
                    accessible-role: AccessibleRole.text;
                    accessible-label: self.text;
                }
            }
        }

        if Shell.primary-label != "": VerticalLayout {
            horizontal-stretch: 0;
            alignment: center;
            Rectangle {
                height: 28px;
                border-radius: self.height / 2;
                background: Theme.hover;
                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 6px;
                    spacing: Theme.gap;
                    Text {
                        text: Shell.primary-label;
                        color: Theme.foreground;
                        font-size: Theme.text-small;
                        font-weight: 500;
                        vertical-alignment: center;
                        overflow: elide;
                        max-width: 200px;
                        accessible-role: AccessibleRole.text;
                        accessible-label: Shell.primary-label;
                    }
                    VerticalLayout {
                        alignment: center;
                        Kbd {
                            keys: Shell.confirm-key;
                        }
                    }
                }
            }
        }

        if Shell.panel-hint: HorizontalLayout {
            horizontal-stretch: 0;
            spacing: 12px;
            VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 1px;
                    height: 14px;
                    background: Theme.border;
                }
            }
            Rectangle {
                accessible-role: button;
                accessible-label: "Actions";
                accessible-action-default => {
                    Intents.toggle-panel();
                }
                HorizontalLayout {
                    spacing: 6px;
                    Text {
                        text: "Actions";
                        color: actions-touch.has-hover ? Theme.foreground : Theme.muted;
                        font-size: Theme.text-small;
                        vertical-alignment: center;
                        accessible-role: none;
                    }
                    VerticalLayout {
                        alignment: center;
                        Kbd {
                            keys: Shell.panel-key;
                        }
                    }
                }
                actions-touch := TouchArea {
                    clicked => {
                        Intents.toggle-panel();
                    }
                }
            }
        }
    }
}
